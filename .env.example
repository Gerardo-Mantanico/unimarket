# PostgreSQL
DB_URL=jdbc:postgresql://unimarket.postgres.database.azure.com:5432/unimarket?sslmode=require
DB_USERNAME=db_unimarket
DB_PASSWORD=tu_password_aqui

# Active storage provider
STORAGE_PROVIDER=azure

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=tuCuenta;AccountKey=tuClave;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=documentos
AZURE_BLOB_PUBLIC_BASE_URL=https://tuCuenta.blob.core.windows.net/documentos

# Optional AWS S3 config
# AWS_REGION=us-east-1
# AWS_BUCKET=mi-bucket
# AWS_ACCESS_KEY=tu-access-key
